# HestiaCP Django-Gunicorn Deployment Engine
# Enforce LF line-endings for all text files to prevent
# bash scripts from breaking on Linux servers when
# edited on Windows.

* text=auto eol=lf

# Explicitly mark shell scripts
*.sh text eol=lf
*.tpl text eol=lf
*.stpl text eol=lf

# Python
*.py text eol=lf

# Docs
*.md text eol=lf
*.txt text eol=lf

# Binary files (no conversion)
*.png binary
*.jpg binary
*.ico binary
